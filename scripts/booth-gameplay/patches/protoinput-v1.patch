+template<typename T> bool SendSyntheticPacket(Proto::ProtoInstance& instance, ProtoPipe::PipeMessageType type, const T& body)
+{
+ if (!instance.pipeHandle || instance.pipeHandle == INVALID_HANDLE_VALUE || !instance.clientConnected) return false;
+ return ProtoSendPipeMessage(instance.pipeHandle, type, &body);
+}
+}
+
+extern "C" __declspec(dllexport) bool SetSyntheticKeyboardEnabled(ProtoInstanceHandle handle, bool enabled)
+{
+ std::lock_guard<std::recursive_mutex> guard(protoPipeSendMutex);
+ const auto found = Proto::instances.find(handle); if (found == Proto::instances.end()) return false;
+ auto& instance = found->second;
+ // Call an existing setup API to establish the pipe first; this new API never
+ // enters the upstream unbounded ConnectNamedPipe wait.
+ const ProtoPipe::PipeMessageSyntheticKeyboardEnabled body{1, enabled ? 1u : 0u};
+ if (!SendSyntheticPacket(instance, ProtoPipe::PipeMessageType::SetSyntheticKeyboardEnabled, body)) return false;
+ instance.syntheticKeyboardEnabled = enabled; return true;
+}
+
+extern "C" __declspec(dllexport) bool SendSyntheticKeyboardEvent(ProtoInstanceHandle handle, unsigned short virtualKey, unsigned short scanCode, unsigned short flags, unsigned int leaseMilliseconds)
+{
+ if (!virtualKey || virtualKey >= 255 || virtualKey == VK_LWIN || virtualKey == VK_RWIN || !scanCode || scanCode > 255 || (flags & ~(RI_KEY_BREAK | RI_KEY_E0 | RI_KEY_E1)) || ((flags & RI_KEY_E0) && (flags & RI_KEY_E1)) ||
+  ((flags & RI_KEY_BREAK) ? leaseMilliseconds != 0 : leaseMilliseconds < 1 || leaseMilliseconds > 2000)) return false;
+ std::lock_guard<std::recursive_mutex> guard(protoPipeSendMutex);
+ const auto found = Proto::instances.find(handle); if (found == Proto::instances.end() || !found->second.syntheticKeyboardEnabled) return false;
+ const ProtoPipe::PipeMessageSyntheticKeyboardEvent body{1, virtualKey, scanCode, flags, 0, leaseMilliseconds};
+ return SendSyntheticPacket(found->second, ProtoPipe::PipeMessageType::SyntheticKeyboardEvent, body);
+}
+
+extern "C" __declspec(dllexport) bool SetSyntheticGamepadEnabled(ProtoInstanceHandle handle, bool enabled)
+{
+ std::lock_guard<std::recursive_mutex> guard(protoPipeSendMutex);
+ auto found=Proto::instances.find(handle);if(found==Proto::instances.end())return false;
+ const ProtoPipe::PipeMessageSyntheticGamepadEnabled body{1,enabled?1u:0u};
+ if(!SendSyntheticPacket(found->second,ProtoPipe::PipeMessageType::SetSyntheticGamepadEnabled,body))return false;
+ found->second.syntheticGamepadEnabled=enabled;return true;
+}
+extern "C" __declspec(dllexport) bool SendSyntheticGamepadState(ProtoInstanceHandle handle, bool connected, unsigned short buttons, unsigned char leftTrigger, unsigned char rightTrigger, short leftX, short leftY, short rightX, short rightY, unsigned int leaseMilliseconds)
+{
+ if((buttons & ~0xF3FFu)||leaseMilliseconds>2000||
+  (connected?leaseMilliseconds<1:(buttons||leftTrigger||rightTrigger||leftX||leftY||rightX||rightY||leaseMilliseconds)))return false;
+ std::lock_guard<std::recursive_mutex> guard(protoPipeSendMutex);
+ auto found=Proto::instances.find(handle);if(found==Proto::instances.end()||!found->second.syntheticGamepadEnabled)return false;
+ const ProtoPipe::PipeMessageSyntheticGamepadState body{1,connected?1u:0u,buttons,leftTrigger,rightTrigger,leftX,leftY,rightX,rightY,0,leaseMilliseconds};
+ return SendSyntheticPacket(found->second,ProtoPipe::PipeMessageType::SyntheticGamepadState,body);
+}
 
