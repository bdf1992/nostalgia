diff --git a/src/ProtoInput/ProtoInputHooks/NostalgiaInputDiagnostics.h b/src/ProtoInput/ProtoInputHooks/NostalgiaInputDiagnostics.h
new file mode 100644
--- /dev/null
+++ b/src/ProtoInput/ProtoInputHooks/NostalgiaInputDiagnostics.h
@@ -0,0 +1,46 @@
+#pragma once
+#include <Windows.h>
+#include <cstddef>
+
+// Read-only consumer ABI. Atomic counters are independent observations.
+// Even, unchanged generation bounds coherent last-value fields, not all counters.
+struct alignas(8) NostalgiaInputDiagnosticsV1 {
+ volatile LONG64 version=1;
+ volatile LONG64 byteSize=96;
+ volatile LONG64 getStateTotal=0;
+ volatile LONG64 getStateExTotal=0;
+ volatile LONG64 syntheticSlot0Success=0;
+ volatile LONG64 syntheticNonzeroButtonsSuccess=0;
+ volatile LONG64 lastSyntheticButtons=0;
+ volatile LONG64 lastSyntheticPacket=0;
+ volatile LONG64 getCapabilitiesTotal=0;
+ volatile LONG64 getForegroundTotal=0;
+ volatile LONG64 lastForegroundHwnd=0;
+ volatile LONG64 generation=0;
+};
+static_assert(alignof(NostalgiaInputDiagnosticsV1)==8,"Diagnostic ABI alignment");
+static_assert(offsetof(NostalgiaInputDiagnosticsV1,lastSyntheticButtons)==48,"Buttons offset");
+static_assert(offsetof(NostalgiaInputDiagnosticsV1,lastSyntheticPacket)==56,"Packet offset");
+static_assert(offsetof(NostalgiaInputDiagnosticsV1,lastForegroundHwnd)==80,"Foreground offset");
+static_assert(sizeof(NostalgiaInputDiagnosticsV1)==96,"Diagnostic ABI size");
+static_assert(offsetof(NostalgiaInputDiagnosticsV1,generation)==88,"Diagnostic ABI offsets");
+extern "C" __declspec(dllexport) NostalgiaInputDiagnosticsV1 NostalgiaInputDiagnosticData;
+extern SRWLOCK NostalgiaDiagnosticWriteLock;
+
+inline void RecordSyntheticXinputReturn(WORD buttons,DWORD packet){
+ InterlockedIncrement64(&NostalgiaInputDiagnosticData.syntheticSlot0Success);
+ if(buttons)InterlockedIncrement64(&NostalgiaInputDiagnosticData.syntheticNonzeroButtonsSuccess);
+ AcquireSRWLockExclusive(&NostalgiaDiagnosticWriteLock);
+ InterlockedIncrement64(&NostalgiaInputDiagnosticData.generation);
+ InterlockedExchange64(&NostalgiaInputDiagnosticData.lastSyntheticButtons,buttons);
+ InterlockedExchange64(&NostalgiaInputDiagnosticData.lastSyntheticPacket,packet);
+ InterlockedIncrement64(&NostalgiaInputDiagnosticData.generation);
+ ReleaseSRWLockExclusive(&NostalgiaDiagnosticWriteLock);
+}
+inline void RecordForegroundReturn(HWND hwnd){
+ AcquireSRWLockExclusive(&NostalgiaDiagnosticWriteLock);
+ InterlockedIncrement64(&NostalgiaInputDiagnosticData.generation);
+ InterlockedExchange64(&NostalgiaInputDiagnosticData.lastForegroundHwnd,static_cast<LONG64>(reinterpret_cast<uintptr_t>(hwnd)));
+ InterlockedIncrement64(&NostalgiaInputDiagnosticData.generation);
+ ReleaseSRWLockExclusive(&NostalgiaDiagnosticWriteLock);
+}
