{
  "name": "nostalgia-agents",
  "version": "0.2.0",
  "private": true,
  "description": "Study games and player requests through shared CLI and MCP operations.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "evaluate:baseline": "npm run build && node scripts/evaluate-baseline.mjs",
    "rehearse:studio": "npm run build && node scripts/rehearse-studio.mjs",
    "provision:browser": "node scripts/provision-browser.mjs",
    "play:fixture": "npm run build && node scripts/play-fixture.mjs",
    "nostalgia": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "csv-parse": "7.0.3",
    "playwright": "1.64.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
